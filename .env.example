POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=lending-indexer
# Used by sqlx and tests on the host; docker-compose builds its own URL from POSTGRES_* above.
DATABASE_URL=postgres://postgres:password@localhost:5432/lending-indexer
API_PORT=8000

# Optional overrides of crates/indexer/configuration/base.yaml (INDEXER_<SECTION>__<KEY>):
# INDEXER_ESPLORA__BASE_URL=https://blockstream.info/liquidtestnet/api
