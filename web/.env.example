# Copy to .env and fill in values.
# For liquid mainnet use .env.liquid, for testnet use .env.liquidtestnet as a starting point.

VITE_API_URL=http://localhost:8000
# For local development against a remote API, use VITE_API_URL=/api and set:
# API_PROXY_TARGET=https://lending.dev.blockstream.com
VITE_NETWORK=liquid
VITE_ESPLORA_BASE_URL=https://blockstream.info/liquid
VITE_WATERFALLS_URL=https://waterfalls.liquidwebwallet.org/liquid/api
VITE_WATERFALLS_RECIPIENT=age1xxzrgrfjm3yrwh3u6a7exgrldked0pdauvr3mx870wl6xzrwm5ps8s2h0p
VITE_PRICES_BASE_URL=https://green-liquid-testnet.blockstream.com

# Optional: BIP39 mnemonic for debug software signer (dev/testnet only).
# Omit this in production — Jade hardware wallet will be used instead.
# VITE_DEBUG_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

# Optional: unlocks demo-only UI (seed-phrase wallet connect, 3-minute offer term).
# Never enable this on the production deployment.
# VITE_DEMO_MODE=true

# Optional: experimental SideSwap wallet connect (testnet only, needs a SideSwap dev
# build to sign — see https://sideswap.io/download/). Unset disables the connect option.
# VITE_SIDESWAP_WS_URL=wss://api-testnet.sideswap.io/server-connect
