  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            offer_id,\n            vault_type AS \"vault_type: VaultType\",\n            txid,\n            vout,\n            amount,\n            already_supplied,\n            is_finalized,\n            created_at_height,\n            updated_at_height,\n            spent_txid,\n            spent_at_height\n        FROM offer_vaults\n        WHERE offer_id = $1\n          AND spent_txid IS NULL\n        ORDER BY vault_type ASC, created_at_height ASC\n        ",
