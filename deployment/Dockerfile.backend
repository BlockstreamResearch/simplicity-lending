FROM rust:1.96-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# simplex-cli is required to generate crates/contracts/src/artifacts (codegen from simf/*.simf).
# Install the `simplex` binary (package smplx-cli) straight from the smplx repo, at the same
# version as CI (.github/actions/build-contracts) and the smplx-std dependency. cargo resolves
# the tag itself, avoiding simplexup's `git clone --revision` (needs git >=2.49) + jq.
ENV SIMPLEX_VERSION=0.2.0
RUN cargo install --locked --git https://github.com/BlockstreamResearch/smplx --tag "v${SIMPLEX_VERSION}" smplx-cli

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY crates ./crates

# Generate Simplicity contract artifacts before building (see CI "Generate contract artifacts").
RUN cd crates/contracts \
    && simplex install \
    && simplex build \
    && test -f src/artifacts/mod.rs

RUN SQLX_OFFLINE=true cargo build --locked --release -p lending-indexer --bin simplicity-lending-indexer

FROM builder AS sqlx-builder

# CARGO_HTTP_MULTIPLEXING=false avoids intermittent "HTTP2 framing layer" crate-download
# failures seen on some networks.
RUN CARGO_HTTP_MULTIPLEXING=false cargo install --locked sqlx-cli --no-default-features --features rustls,postgres

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --uid 10001 appuser

WORKDIR /app

COPY --from=builder /app/target/release/simplicity-lending-indexer /usr/local/bin/simplicity-lending-indexer
COPY --from=sqlx-builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx
COPY crates/indexer/migrations migrations
COPY crates/indexer/configuration configuration

# base.yaml holds public defaults; DATABASE_URL and INDEXER_* overrides come from the environment.
ENV INDEXER_APPLICATION__HOST=0.0.0.0

USER appuser
CMD ["simplicity-lending-indexer"]
