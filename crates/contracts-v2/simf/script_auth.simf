use std::lib::asserts::assert_eq_256;

use crate::utils::storage::{get_u256_slot_leaf, get_script_hash_for_tap_node};

fn script_hash_for(auth_script_hash: u256) -> u256 {
    let auth_script_hash_slot_leaf: u256 = get_u256_slot_leaf(auth_script_hash);

    let tap_node: u256 = jet::build_tapbranch(jet::tapleaf_hash(), auth_script_hash_slot_leaf);

    get_script_hash_for_tap_node(tap_node)
}

fn assert_storage_with_current(auth_script_hash: u256) {
    assert_eq_256(jet::current_script_hash(), script_hash_for(auth_script_hash));
}

fn assert_input_script_hash(input_index: u32, expected_script_hash: u256) {
    let input_script_hash: u256 = unwrap(jet::input_script_hash(input_index));

    assert_eq_256(input_script_hash, expected_script_hash);
}

fn script_auth_check(auth_input_index: u32, auth_script_hash: u256) {
    assert_storage_with_current(auth_script_hash);

    assert_input_script_hash(auth_input_index, auth_script_hash);
}

fn main() {
    script_auth_check(witness::AUTH_INPUT_INDEX, witness::AUTH_SCRIPT_HASH);
}
