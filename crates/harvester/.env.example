# Directory that contains base.yaml (default: ./configuration)
HARVESTER_CONFIGURATION_DIR=""
# Path to the collector state file (default: ./state.json)
HARVESTER_STATE_PATH=""

# BIP-39 mnemonic of the wallet that pays fees for harvest
HARVESTER_HARVEST__MNEMONIC=""
# BIP-39 mnemonic of the wallet that signs withdrawals and pays their fees
HARVESTER_WITHDRAW__MNEMONIC=""

# x-only public key (hex) authorized to withdraw from the fee collector
HARVESTER_COLLECTOR__WITHDRAW_PUBKEY=""
# Liquid address that receives withdrawn fees (`withdraw --to` overrides this)
HARVESTER_WITHDRAW__DESTINATION_ADDRESS=""
# Seconds between harvest passes in `run` (base.yaml default: 86400)
HARVESTER_SCHEDULE__INTERVAL_SECS=""
