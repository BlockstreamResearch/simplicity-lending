use std::lib::binary::not;
use std::lib::op_return::is_output_op_return;
use std::lib::u64::{safe_add_64, safe_sub_64};

use crate::helper::{
    get_explicit_asset_and_amount,
    check_asset_amounts_eq,
    check_assets_eq,
    check_flags_eq
};

use crate::checks::{
    ensure_io_asset_eq,
    ensure_input_script_hash,
    ensure_output_script_hash,
    ensure_asset_transition_with_additional_amount
};

// Check helpers

fn ensure_active_status(expected_status: bool) {
    check_flags_eq(expected_status, param::IS_ACTIVE);
}

fn ensure_vault_asset(index: u32, is_input_index: bool) -> u64 {
    let (
        vault_asset_id,
        vault_amount
    ): (u256, u64) = get_explicit_asset_and_amount(index, is_input_index);

    check_assets_eq(vault_asset_id, param::VAULT_ASSET_ID);

    vault_amount
}

fn ensure_input_vault_asset(input_index: u32) -> u64 {
    ensure_vault_asset(input_index, true)
}

fn ensure_output_vault_asset(output_index: u32) -> u64 {
    ensure_vault_asset(output_index, false)
}

// Storage logic

fn get_is_active_slot_leaf(is_active: bool) -> u256 {
    let is_active_num: u64 = jet::left_pad_low_1_64(<bool>::into(is_active));
    let is_active_num: u256 = <(u128, u128)>::into((0, <(u64, u64)>::into((0, is_active_num))));

    let state_ctx1: Ctx8 = jet::tapdata_init();
    let state_ctx2: Ctx8 = jet::sha_256_ctx_8_add_32(state_ctx1, is_active_num);

    jet::sha_256_ctx_8_finalize(state_ctx2)
}

fn get_already_supplied_slot_leaf(already_supplied: u64) -> u256 {
    let already_supplied: u256 = <(u128, u128)>::into(
        (0, <(u64, u64)>::into((0, already_supplied)))
    );

    let state_ctx1: Ctx8 = jet::tapdata_init();
    let state_ctx2: Ctx8 = jet::sha_256_ctx_8_add_32(state_ctx1, already_supplied);

    jet::sha_256_ctx_8_finalize(state_ctx2)
}

fn get_script_hash_for_storage(is_active: bool, already_supplied: u64) -> u256 {
    let is_active_slot_leaf: u256 = get_is_active_slot_leaf(is_active);
    let already_supplied_slot_leaf: u256 = get_already_supplied_slot_leaf(already_supplied);

    let first_tap_node: u256 = jet::build_tapbranch(jet::tapleaf_hash(), is_active_slot_leaf);
    let tap_node: u256 = jet::build_tapbranch(first_tap_node, already_supplied_slot_leaf);

    // Compute a TapTweak
    let bip0341_key: u256 = 0x50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0;
    let tweaked_key: u256 = jet::build_taptweak(bip0341_key, tap_node);

    // Turn the TapTweak into a script hash
    let hash_ctx1: Ctx8 = jet::sha_256_ctx_8_init();
    let hash_ctx2: Ctx8 = jet::sha_256_ctx_8_add_2(hash_ctx1, 0x5120); // Segwit v1, length 32
    let hash_ctx3: Ctx8 = jet::sha_256_ctx_8_add_32(hash_ctx2, tweaked_key);

    jet::sha_256_ctx_8_finalize(hash_ctx3)
}

// Auth logic

fn auth_with_burn_check(
    input_asset_index: u32,
    output_asset_index: u32,
    expected_asset_id: u256,
    with_asset_burn: bool
) {
    let (input_amount, output_amount): (u64, u64) = ensure_io_asset_eq(input_asset_index, output_asset_index, expected_asset_id);

    check_asset_amounts_eq(input_amount, output_amount);

    match with_asset_burn {
        true => {
            assert!(is_output_op_return(output_asset_index));
        },
        false => {
            assert!(not(is_output_op_return(output_asset_index)));
        }
    }
}

// Main paths logic

fn get_amount_to_goal(already_supplied: u64) -> u64 {
    safe_sub_64(param::SUPPLY_GOAL, already_supplied)
}

fn withdraw_all(input_keeper_index: u32, output_keeper_index: u32) {
    let current_script_hash: u256 = get_script_hash_for_storage(false, param::SUPPLY_GOAL);

    ensure_input_script_hash(jet::current_index(), current_script_hash);

    auth_with_burn_check(
        input_keeper_index,
        output_keeper_index,
        param::KEEPER_AUTH_ASSET_ID,
        param::WITH_KEEPER_ASSET_BURN
    );

    let _: u64 = ensure_input_vault_asset(jet::current_index());
}

fn withdraw_part(
    input_keeper_index: u32,
    output_keeper_index: u32,
    vault_output_index: u32,
    already_supplied: u64,
    amount_to_withdraw: u64
) {
    let current_script_hash: u256 = get_script_hash_for_storage(true, already_supplied);

    ensure_input_script_hash(jet::current_index(), current_script_hash);

    auth_with_burn_check(
        input_keeper_index,
        output_keeper_index,
        param::KEEPER_AUTH_ASSET_ID,
        false
    );

    ensure_output_script_hash(vault_output_index, current_script_hash);

    let vault_amount: u64 = ensure_input_vault_asset(jet::current_index());
    let output_vault_amount: u64 = ensure_output_vault_asset(vault_output_index);

    assert!(jet::lt_64(amount_to_withdraw, vault_amount));

    let vault_change: u64 = safe_sub_64(vault_amount, amount_to_withdraw);

    check_asset_amounts_eq(output_vault_amount, vault_change);
}

fn supply(
    input_supplier_index: u32,
    output_supplier_index: u32,
    vault_output_index: u32,
    already_supplied: u64,
    amount_to_supply: u64
) {
    let current_script_hash: u256 = get_script_hash_for_storage(true, already_supplied);

    ensure_input_script_hash(jet::current_index(), current_script_hash);

    auth_with_burn_check(
        input_supplier_index,
        output_supplier_index,
        param::SUPPLIER_AUTH_ASSET_ID,
        false
    );

    let amount_to_goal: u64 = get_amount_to_goal(already_supplied);

    assert!(jet::some_64(amount_to_supply));
    assert!(jet::lt_64(amount_to_supply, amount_to_goal));

    let new_supplied_amount: u64 = safe_add_64(already_supplied, amount_to_supply);
    let new_script_hash: u256 = get_script_hash_for_storage(true, new_supplied_amount);

    ensure_output_script_hash(vault_output_index, new_script_hash);

    ensure_asset_transition_with_additional_amount(
        jet::current_index(),
        vault_output_index,
        param::VAULT_ASSET_ID,
        amount_to_supply
    );
}

fn final_supply(
    input_supplier_index: u32,
    output_supplier_index: u32,
    finalized_vault_output_index: u32,
    already_supplied: u64,
) {
    let current_script_hash: u256 = get_script_hash_for_storage(true, already_supplied);

    ensure_input_script_hash(jet::current_index(), current_script_hash);

    auth_with_burn_check(
        input_supplier_index,
        output_supplier_index,
        param::SUPPLIER_AUTH_ASSET_ID,
        param::WITH_SUPPLIER_ASSET_BURN
    );

    let finalized_vault_script_hash: u256 = get_script_hash_for_storage(false, param::SUPPLY_GOAL);

    ensure_output_script_hash(finalized_vault_output_index, finalized_vault_script_hash);

    ensure_asset_transition_with_additional_amount(
        jet::current_index(),
        finalized_vault_output_index,
        param::VAULT_ASSET_ID,
        get_amount_to_goal(already_supplied)
    );
}

fn main() {
    match witness::PATH {
        Left(withdraw_params: Either<(u32, u32), (u32, u32, u32, u64, u64)>) => {
            match withdraw_params {
                Left(withdraw_all_params: (u32, u32)) => {
                    let (input_keeper_index, output_keeper_index): (u32, u32) = withdraw_all_params;

                    withdraw_all(input_keeper_index, output_keeper_index);
                },
                Right(withdraw_part_params: (u32, u32, u32, u64, u64)) => {
                    let (
                        input_keeper_index,
                        output_keeper_index,
                        vault_output_index,
                        already_supplied,
                        amount_to_withdraw
                    ): (u32, u32, u32, u64, u64) = withdraw_part_params;

                    withdraw_part(
                        input_keeper_index,
                        output_keeper_index,
                        vault_output_index,
                        already_supplied,
                        amount_to_withdraw
                    );
                }
            }
        },
        Right(supply_params: Either<(u32, u32, u32, u64, u64), (u32, u32, u32, u64)>) => {
            match supply_params {
                Left(supply_params: (u32, u32, u32, u64, u64)) => {
                    let (
                        input_supplier_index,
                        output_supplier_index,
                        vault_output_index,
                        already_supplied,
                        amount_to_supply
                    ): (u32, u32, u32, u64, u64) = supply_params;

                    supply(
                        input_supplier_index,
                        output_supplier_index,
                        vault_output_index,
                        already_supplied,
                        amount_to_supply
                    );
                },
                Right(final_supply_params: (u32, u32, u32, u64)) => {
                    let (
                        input_supplier_index,
                        output_supplier_index,
                        finalized_vault_output_index,
                        already_supplied
                    ): (u32, u32, u32, u64) = final_supply_params;

                    final_supply(
                        input_supplier_index,
                        output_supplier_index,
                        finalized_vault_output_index,
                        already_supplied
                    );
                }
            }
        }
    }
}
