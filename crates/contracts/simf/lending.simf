use std::lib::asserts::assert_eq_32;
use std::lib::u64::math::{add_64, sub_64};
use std::lib::u64::mul_div::mul_div_64;
use std::lib::u64::convert::u64_to_u256;
use std::lib::u32::math::add_32;

use crate::helper::{get_input_explicit_asset_and_amount, check_asset_amounts_eq, check_assets_eq};

use crate::checks::{
    ensure_non_zero_amount,
    ensure_input_script_hash,
    ensure_output_script_hash,
    ensure_script_hash_transition,
    ensure_input_asset_and_amount,
    ensure_output_asset_and_amount,
    ensure_io_asset_and_amount_eq,
    ensure_input_asset_and_amount_burn,
    ensure_asset_transition_with_additional_amount
};

use crate::storage::{get_bool_slot_leaf, get_u64_slot_leaf, get_script_hash_from_tap_node};

// Math helpers

fn min_64(first: u64, second: u64) -> u64 {
    match jet::lt_64(first, second) {
        true => {
            first
        },
        false => {
            second
        }
    }
}

// Basis points math

fn get_max_basis_points() -> u64 {
    10_000
}

fn apply_basis_points(amount: u64, bps: u64) -> u64 {
    mul_div_64(amount, bps, get_max_basis_points())
}

// Storage helpers

fn get_script_hash_for_vault_storage(vault_tapleaf_hash: u256, is_active: bool, already_supplied: u64) -> u256 {
    let is_active_slot_leaf: u256 = get_bool_slot_leaf(is_active);
    let already_supplied_slot_leaf: u256 = get_u64_slot_leaf(already_supplied);

    let first_tap_node: u256 = jet::build_tapbranch(vault_tapleaf_hash, is_active_slot_leaf);
    let tap_node: u256 = jet::build_tapbranch(first_tap_node, already_supplied_slot_leaf);

    get_script_hash_from_tap_node(tap_node)
}

fn get_script_hash_for_offer_storage(is_active: bool, borrower_debt: u64) -> u256 {
    let is_active_slot_leaf: u256 = get_bool_slot_leaf(is_active);
    let borrower_debt_slot_leaf: u256 = get_u64_slot_leaf(borrower_debt);

    let first_tap_node: u256 = jet::build_tapbranch(jet::tapleaf_hash(), is_active_slot_leaf);
    let tap_node: u256 = jet::build_tapbranch(first_tap_node, borrower_debt_slot_leaf);

    get_script_hash_from_tap_node(tap_node)
}

// Main paths helpers

fn get_protocol_fee_amount(fee_amount: u64) -> u64 {
    apply_basis_points(fee_amount, param::PROTOCOL_FEE_RATE)
}

fn get_total_fee_amount() -> u64 {
    apply_basis_points(param::PRINCIPAL_AMOUNT, param::PRINCIPAL_INTEREST_RATE)
}

// Simplicity charges every call site of the worst-case path taken anywhere in the pruned program,
// so the fee and the total debt are computed once per spend and passed down. Recomputing them
// pushes the partial repayment over its budget as soon as `mul_div_64` takes the 128-bit path.
fn get_total_amount_to_repay(total_fee_amount: u64) -> u64 {
    add_64(param::PRINCIPAL_AMOUNT, total_fee_amount)
}

fn get_collateral_for_principal(principal_amount: u64, total_amount_to_repay: u64) -> u64 {
    mul_div_64(principal_amount, param::COLLATERAL_AMOUNT, total_amount_to_repay)
}

fn get_repaid_protocol_fee(total_fee_amount: u64, already_repaid_amount: u64) -> u64 {
    let fee_repaid: u64 = min_64(total_fee_amount, already_repaid_amount);

    get_protocol_fee_amount(fee_repaid)
}

fn validate_collateral_input(
    input_index: u32,
    current_debt: u64,
    total_amount_to_repay: u64
) -> (u64, u64) {
    let (
        asset_bits,
        current_collateral_amount
    ): (u256, u64) = get_input_explicit_asset_and_amount(input_index);

    let already_paid_debt: u64 = sub_64(total_amount_to_repay, current_debt);
    let already_unlocked_collateral: u64 = get_collateral_for_principal(
        already_paid_debt,
        total_amount_to_repay
    );

    let total_collateral_amount: u64 = add_64(
        current_collateral_amount,
        already_unlocked_collateral
    );

    check_assets_eq(asset_bits, param::COLLATERAL_ASSET_ID);
    check_asset_amounts_eq(total_collateral_amount, param::COLLATERAL_AMOUNT);

    (current_collateral_amount, already_unlocked_collateral)
}

// A vault exists exactly when something has already been supplied to it: the first non-zero
// supply creates it as a plain output, every later one moves it from input to output. A zero
// supply never reaches this function, so no zero-value vault output is ever required.
fn validate_vault_supply(
    vault_tapleaf_hash: u256,
    vault_indexes: (u32, u32),
    already_supplied_before: u64,
    amount_to_supply: u64,
    is_final_supply: bool
) {
    let (vault_input_index, vault_output_index): (u32, u32) = vault_indexes;

    // A finalized vault stores its supply goal, which is exactly the amount supplied after the final supply.
    let already_supplied_after: u64 = add_64(already_supplied_before, amount_to_supply);
    let new_vault_cov_hash: u256 = match is_final_supply {
        true => get_script_hash_for_vault_storage(vault_tapleaf_hash, false, already_supplied_after),
        false => get_script_hash_for_vault_storage(vault_tapleaf_hash, true, already_supplied_after),
    };

    match jet::some_64(already_supplied_before) {
        true => {
            let current_vault_cov_hash: u256 = get_script_hash_for_vault_storage(
                vault_tapleaf_hash,
                true,
                already_supplied_before
            );

            ensure_asset_transition_with_additional_amount(
                vault_input_index,
                vault_output_index,
                param::PRINCIPAL_ASSET_ID,
                amount_to_supply
            );
            ensure_script_hash_transition(
                vault_input_index,
                vault_output_index,
                current_vault_cov_hash,
                new_vault_cov_hash
            );
        },
        false => {
            ensure_output_asset_and_amount(
                vault_output_index,
                param::PRINCIPAL_ASSET_ID,
                amount_to_supply
            );
            ensure_output_script_hash(vault_output_index, new_vault_cov_hash);
        },
    };
}

fn validate_vaults(
    lender_vault_indexes: (u32, u32),
    protocol_fee_vault_indexes: (u32, u32),
    current_borrower_debt: u64,
    amount_to_repay: u64,
    total_fee_amount: u64,
    total_amount_to_repay: u64
) {
    let already_repaid_amount_before: u64 = sub_64(total_amount_to_repay, current_borrower_debt);
    let already_repaid_amount_after: u64 = add_64(already_repaid_amount_before, amount_to_repay);

    let already_repaid_protocol_fee_before: u64 = get_repaid_protocol_fee(total_fee_amount, already_repaid_amount_before);
    let already_repaid_protocol_fee_after: u64 = get_repaid_protocol_fee(total_fee_amount, already_repaid_amount_after);

    let protocol_fee_repaid: u64 = sub_64(already_repaid_protocol_fee_after, already_repaid_protocol_fee_before);

    let additional_lender_vault_amount: u64 = sub_64(amount_to_repay, protocol_fee_repaid);
    ensure_non_zero_amount(additional_lender_vault_amount);

    let lender_vault_already_supplied: u64 = sub_64(already_repaid_amount_before, already_repaid_protocol_fee_before);

    validate_vault_supply(
        param::LENDER_VAULT_TAPLEAF_HASH,
        lender_vault_indexes,
        lender_vault_already_supplied,
        additional_lender_vault_amount,
        jet::eq_64(current_borrower_debt, amount_to_repay)
    );

    // The protocol fee vault is only touched when this repayment owes the protocol something.
    // With a zero rate, or while rounding keeps the protocol share at zero, it is not created at all.
    match jet::some_64(protocol_fee_repaid) {
        true => {
            let total_protocol_fee: u64 = get_protocol_fee_amount(total_fee_amount);

            validate_vault_supply(
                param::PROTOCOL_FEE_VAULT_TAPLEAF_HASH,
                protocol_fee_vault_indexes,
                already_repaid_protocol_fee_before,
                protocol_fee_repaid,
                jet::eq_64(already_repaid_protocol_fee_after, total_protocol_fee)
            );
        },
        false => {}
    };
}

// Partial repayment flow

fn get_partial_repayment_offer_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 1), add_32(start_output_index, 1))
}

fn get_partial_repayment_lender_vault_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 2), add_32(start_output_index, 2))
}

fn get_partial_repayment_protocol_fee_vault_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 3), add_32(start_output_index, 3))
}

fn partial_repay_offer(current_debt: u64, amount_to_repay: u64) {
    let (borrower_nft_input_index, borrower_nft_output_index): (u32, u32) = (0, 0);
    let (
        offer_input_index,
        offer_output_index
    ): (u32, u32) = get_partial_repayment_offer_indexes(
        borrower_nft_input_index,
        borrower_nft_output_index
    );

    assert_eq_32(jet::current_index(), offer_input_index);

    let current_script_hash: u256 = get_script_hash_for_offer_storage(true, current_debt);
    ensure_input_script_hash(offer_input_index, current_script_hash);

    ensure_non_zero_amount(amount_to_repay);
    assert!(jet::lt_64(amount_to_repay, current_debt));

    let total_fee_amount: u64 = get_total_fee_amount();
    let total_amount_to_repay: u64 = get_total_amount_to_repay(total_fee_amount);

    let (
        current_collateral_amount,
        already_unlocked_collateral_before
    ): (u64, u64) = validate_collateral_input(offer_input_index, current_debt, total_amount_to_repay);

    let already_paid_debt_before: u64 = sub_64(total_amount_to_repay, current_debt);
    let already_paid_debt_after: u64 = add_64(already_paid_debt_before, amount_to_repay);

    let already_unlocked_collateral_after: u64 = get_collateral_for_principal(
        already_paid_debt_after,
        total_amount_to_repay
    );

    let collateral_to_unlock: u64 = sub_64(already_unlocked_collateral_after, already_unlocked_collateral_before);
    let new_collateral_amount: u64 = sub_64(current_collateral_amount, collateral_to_unlock);

    ensure_output_asset_and_amount(
        offer_output_index,
        param::COLLATERAL_ASSET_ID,
        new_collateral_amount
    );

    let new_debt: u64 = sub_64(current_debt, amount_to_repay);
    let new_offer_script_hash: u256 = get_script_hash_for_offer_storage(true, new_debt);

    ensure_output_script_hash(offer_output_index, new_offer_script_hash);

    ensure_io_asset_and_amount_eq(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );

    validate_vaults(
        get_partial_repayment_lender_vault_indexes(
            borrower_nft_input_index,
            borrower_nft_output_index
        ),
        get_partial_repayment_protocol_fee_vault_indexes(
            borrower_nft_input_index,
            borrower_nft_output_index
        ),
        current_debt,
        amount_to_repay,
        total_fee_amount,
        total_amount_to_repay
    );
}

// Full repayment flow

fn get_full_repayment_offer_input_index(start_input_index: u32) -> u32 {
    add_32(start_input_index, 1)
}

fn get_full_repayment_lender_vault_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 2), add_32(start_output_index, 1))
}

fn get_full_repayment_protocol_fee_vault_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 3), add_32(start_output_index, 2))
}

fn full_repay_offer(current_debt: u64) {
    let (borrower_nft_input_index, borrower_nft_output_index): (u32, u32) = (0, 0);
    let offer_input_index: u32 = get_full_repayment_offer_input_index(borrower_nft_input_index);

    assert_eq_32(jet::current_index(), offer_input_index);

    let current_script_hash: u256 = get_script_hash_for_offer_storage(true, current_debt);
    ensure_input_script_hash(offer_input_index, current_script_hash);

    let total_fee_amount: u64 = get_total_fee_amount();
    let total_amount_to_repay: u64 = get_total_amount_to_repay(total_fee_amount);

    let _: (u64, u64) = validate_collateral_input(offer_input_index, current_debt, total_amount_to_repay);

    ensure_input_asset_and_amount_burn(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );

    validate_vaults(
        get_full_repayment_lender_vault_indexes(
            borrower_nft_input_index,
            borrower_nft_output_index
        ),
        get_full_repayment_protocol_fee_vault_indexes(
            borrower_nft_input_index,
            borrower_nft_output_index
        ),
        current_debt,
        current_debt,
        total_fee_amount,
        total_amount_to_repay
    );
}

// Liquidation flow

fn get_liquidation_lender_nft_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 1), start_output_index)
}

fn liquidate_offer(current_debt: u64) {
    let (lending_input_index, lending_output_index): (u32, u32) = (jet::current_index(), 0);
    let (
        lender_nft_input_index,
        lender_nft_output_index
    ): (u32, u32) = get_liquidation_lender_nft_indexes(lending_input_index, lending_output_index);

    assert!(jet::is_zero_32(lending_input_index));

    let current_script_hash: u256 = get_script_hash_for_offer_storage(true, current_debt);
    ensure_input_script_hash(lending_input_index, current_script_hash);

    jet::check_lock_height(param::LOAN_EXPIRATION_TIME);

    let total_amount_to_repay: u64 = get_total_amount_to_repay(get_total_fee_amount());

    let _: (u64, u64) = validate_collateral_input(lending_input_index, current_debt, total_amount_to_repay);

    ensure_input_asset_and_amount_burn(
        lender_nft_input_index,
        lender_nft_output_index,
        param::LENDER_NFT_ASSET_ID,
        1
    );
}

// Offer acceptance flow

fn get_acceptance_principal_output_index(
    start_output_index: u32
) -> u32 {
    add_32(start_output_index, 1)
}

fn get_acceptance_lender_nft_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 1), add_32(start_output_index, 2))
}

fn accept_offer() {
    let (lending_input_index, lending_output_index): (u32, u32) = (jet::current_index(), 0);
    let (
        lender_nft_input_index,
        lender_nft_output_index
    ): (u32, u32) = get_acceptance_lender_nft_indexes(lending_input_index, lending_output_index);
    let principal_output_index: u32 = get_acceptance_principal_output_index(lending_output_index);

    assert!(jet::is_zero_32(lending_input_index));

    // A rate above 100% makes the protocol share exceed the interest, so every repayment would
    // underflow and the loan could only be liquidated. Rejecting it here keeps such offers pending.
    assert!(jet::le_64(param::PROTOCOL_FEE_RATE, get_max_basis_points()));

    let total_amount_to_repay: u64 = get_total_amount_to_repay(get_total_fee_amount());
    let current_script_hash: u256 = get_script_hash_for_offer_storage(false, total_amount_to_repay);
    let active_offer_script_hash: u256 = get_script_hash_for_offer_storage(true, total_amount_to_repay);

    ensure_io_asset_and_amount_eq(
        lending_input_index,
        lending_output_index,
        param::COLLATERAL_ASSET_ID,
        param::COLLATERAL_AMOUNT
    );
    ensure_script_hash_transition(
        lending_input_index,
        lending_output_index,
        current_script_hash,
        active_offer_script_hash
    );

    ensure_io_asset_and_amount_eq(
        lender_nft_input_index,
        lender_nft_output_index,
        param::LENDER_NFT_ASSET_ID,
        1
    );

    ensure_output_asset_and_amount(
        principal_output_index,
        param::PRINCIPAL_ASSET_ID,
        param::PRINCIPAL_AMOUNT
    );
    ensure_output_script_hash(principal_output_index, param::PRINCIPAL_OUTPUT_SCRIPT_HASH);
}

// Offer cancellation flow

fn get_cancellation_lender_nft_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 1), start_output_index)
}

fn get_cancellation_borrower_nft_indexes(
    start_input_index: u32,
    start_output_index: u32
) -> (u32, u32) {
    (add_32(start_input_index, 2), add_32(start_output_index, 1))
}

fn cancel_offer() {
    let lending_input_index: u32 = jet::current_index();
    let (
        lender_nft_input_index,
        lender_nft_output_index
    ): (u32, u32) = get_cancellation_lender_nft_indexes(lending_input_index, 0);
    let (
        borrower_nft_input_index,
        borrower_nft_output_index
    ): (u32, u32) = get_cancellation_borrower_nft_indexes(lending_input_index, 0);

    assert!(jet::is_zero_32(lending_input_index));

    let total_amount_to_repay: u64 = get_total_amount_to_repay(get_total_fee_amount());
    let current_script_hash: u256 = get_script_hash_for_offer_storage(false, total_amount_to_repay);
    ensure_input_script_hash(lending_input_index, current_script_hash);

    ensure_input_asset_and_amount(
        lending_input_index,
        param::COLLATERAL_ASSET_ID,
        param::COLLATERAL_AMOUNT
    );

    ensure_input_asset_and_amount_burn(
        borrower_nft_input_index,
        borrower_nft_output_index,
        param::BORROWER_NFT_ASSET_ID,
        1
    );
    ensure_input_asset_and_amount_burn(
        lender_nft_input_index,
        lender_nft_output_index,
        param::LENDER_NFT_ASSET_ID,
        1
    );
}

fn main() {
    match witness::PATH {
        Left(pending_offer_params: Either<(), ()>) => {
            match pending_offer_params {
                Left(params: ()) => {
                    accept_offer();
                },
                Right(params: ()) => {
                    cancel_offer();
                }
            }
        },
        Right(active_offer_params: Either<Either<(u64, u64), u64>, u64>) => {
            match active_offer_params {
                Left(repayment_params: Either<(u64, u64), u64>) => {
                    match repayment_params {
                        Left(partial_repayment_params: (u64, u64)) => {
                            let (
                                current_debt,
                                amount_to_repay
                            ): (u64, u64) = partial_repayment_params;

                            partial_repay_offer(current_debt, amount_to_repay);
                        },
                        Right(current_debt: u64) => {
                            full_repay_offer(current_debt);
                        }
                    }
                },
                Right(current_debt: u64) => {
                    liquidate_offer(current_debt);
                }
            }
        }
    }
}
