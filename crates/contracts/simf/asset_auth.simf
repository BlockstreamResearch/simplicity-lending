use std::lib::op_return::assert_output_is_op_return;

use crate::checks::{ensure_input_asset_and_amount, ensure_output_asset_and_amount};

fn auth_with_burn_check(input_asset_index: u32, output_asset_index: u32) {
    ensure_input_asset_and_amount(input_asset_index, param::ASSET_ID, param::ASSET_AMOUNT);
    ensure_output_asset_and_amount(output_asset_index, param::ASSET_ID, param::ASSET_AMOUNT);

    match param::WITH_ASSET_BURN {
        false => {},
        true => {
            assert_output_is_op_return(output_asset_index);
        }
    }
}

fn main() {
    auth_with_burn_check(witness::INPUT_ASSET_INDEX, witness::OUTPUT_ASSET_INDEX);
}
