use crate::checks::{
    ensure_non_zero_amount,
    ensure_io_script_hashes_eq,
    ensure_asset_transition_with_additional_amount
};
use crate::helper::get_input_explicit_asset_and_amount;

fn checksig(pubkey: Pubkey, sig: Signature) {
    let sighash: u256 = jet::sig_all_hash();

    jet::bip_0340_verify((pubkey, sighash), sig);
}

fn deposit(output_index: u32, additional_amount: u64) {
    ensure_non_zero_amount(additional_amount);

    let current_index: u32 = jet::current_index();
    let (asset_bits, _): (u256, u64) = get_input_explicit_asset_and_amount(current_index);

    ensure_io_script_hashes_eq(current_index, output_index);
    ensure_asset_transition_with_additional_amount(
        current_index,
        output_index,
        asset_bits,
        additional_amount
    );
}

fn main() {
    match witness::PATH {
        Left(signature: Signature) => {
            checksig(param::WITHDRAWAL_PUBKEY, signature);
        },
        Right(deposit_params: (u32, u64)) => {
            let (output_index, additional_amount): (u32, u64) = deposit_params;

            deposit(output_index, additional_amount);
        }
    }
}
