# Postgres connection string (also used by sqlx-cli and the integration tests)
DATABASE_URL=postgres://postgres:password@localhost:5432/lending-indexer

# Directory that contains base.yaml (default: ./configuration)
# INDEXER_CONFIGURATION_DIR=./configuration

# Any key of configuration/base.yaml can be overridden as INDEXER_<SECTION>__<KEY>:
# INDEXER_APPLICATION__PORT=8000
# INDEXER_ESPLORA__BASE_URL=https://blockstream.info/liquidtestnet/api
# INDEXER_ESPLORA__NETWORK=liquidtestnet
# INDEXER_INDEXER__LAST_INDEXED_HEIGHT=2601330
# Issuer domain for ELIP-0100 asset registration (registration stays disabled while unset)
# INDEXER_INDEXER__ASSET_REGISTRY__DOMAIN=lending.example.com
# Set to an empty value to skip registry submission
# INDEXER_INDEXER__ASSET_REGISTRY__REGISTRY_URL=
